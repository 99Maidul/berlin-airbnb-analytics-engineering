```gitignore
# Python
__pycache__/
*.pyc
.venv/
env/

# dbt
target/
dbt_packages/
logs/

# Snowflake / dbt profiles
profiles.yml
*.user.yml

# VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db

# Environment variables
.env

# Power BI cache
*.pbix.autorecover

# dbt docs static site
catalog.json
manifest.json
partial_parse.msgpack
run_results.json

# Mac/Linux
*.swp
```
